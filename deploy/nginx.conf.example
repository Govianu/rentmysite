# Nginx in front of the Node app on the VPS, when nginx alone serves the site (no Apache/public_html).
# Copy to /etc/nginx/sites-available/partnermybusiness, change server_name, then run certbot for HTTPS.
server {
    listen 80;
    server_name partnermybusiness.ai www.partnermybusiness.ai;

    # Uploads go up to 100 MB (promo videos)
    client_max_body_size 110m;

    location / {
        proxy_pass http://127.0.0.1:3000;   # PORT in .env
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
