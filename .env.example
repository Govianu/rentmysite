# ---------- Required ----------
JWT_SECRET=change-this-to-a-long-random-string
# Optional. Leave empty: team sign-up needs only a Govianu email (confirmed by a code sent to it).
# Set it to also require this code when someone signs up for the team dashboard.
ADMIN_INVITE_CODE=
# Only these email domains can open the RentMySite team dashboard (comma separated). Everyone else gets the usual dashboards.
STAFF_EMAIL_DOMAINS=govianu.com
PORT=3000
# npm run build writes the static pages here (default ./dist). On the VPS: /home/<user>/public_html
# BUILD_OUT=/home/<user>/public_html
# Proxies whose X-Forwarded-For is trusted for visitor IPs. 'loopback' fits nginx -> Apache -> Node on one server.
# TRUST_PROXY=loopback
# The public address of the site. Used for links inside emails.
APP_URL=https://rentmysite.ai
# Where accounts, uploads and lesson videos are kept. On the VPS, use a folder outside the code
# so deploys don't touch it (for example /var/lib/rentmysite and /var/lib/rentmysite/uploads).
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# ---------- Email (needed for enquiry, dashboard and booking emails) ----------
# Brevo's HTTPS API works even where outbound SMTP ports are blocked (many VPS providers block port 25).
# The sender in MAIL_FROM must be verified in Brevo. If set, this API key takes precedence over SMTP.
BREVO_API_KEY=
# SMTP works locally and on hosts that allow outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@rentmysite.ai
SMTP_PASS=
MAIL_FROM=RentMySite.ai <info@rentmysite.ai>
# Where every new enquiry is sent
TEAM_INBOX=info@rentmysite.ai

# ---------- Business-opportunity emails after sign-up ----------
# Five emails, a few days apart, about ways each business type or profession can earn. Sent 9am-7pm IST,
# with a one-tap dashboard button and an unsubscribe link. Set DRIP_ENABLED=false to turn them off.
DRIP_ENABLED=true
DRIP_INTERVAL_DAYS=3
DRIP_MAX_PER_RUN=40
# Set to true once (then restart) to also send them to partners who signed up before these emails existed
DRIP_ENROLL_EXISTING=false
# Dashboard "people" strip: network numbers below this are hidden rather than shown small
COMMUNITY_MIN_COUNT=10
# Shown on every dashboard as "5,000+ people have joined RentMySite". Set it to the real size of the network.
NETWORK_MEMBERS=5,000+

# ---------- Optional ----------
# Claude API key (console.anthropic.com). With it, every sign-up's own business is looked up on the web
# (what it sells, busy and quiet hours) and its 5 ways to earn and 5 ways to save are written for it, in the
# sign-up email and the dashboard. Without it everyone gets the general plan for their type of business.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model for the business lookup, and how long the sign-up email waits for it (ms) before sending the general plan
RESEARCH_MODEL=claude-opus-5-5
RESEARCH_WAIT_MS=25000

# Real Google Meet links when a business accepts a booking
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Razorpay Route split payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_INFRA_ACCOUNT=
RAZORPAY_LEADGEN_ACCOUNT=

# Set to production on the live server (hides test links, secures cookies)
NODE_ENV=production

# ---------- AI images and presenter videos for lessons (Higgsfield, optional) ----------
# Each lesson video is made the first time someone opens it, saved on this server, and reused for
# everyone with the same business type and topic. Without these, lessons use the animated slides.
# 1. Create an API key at console.higgsfield.ai and add credit. You get a key ID and a key secret.
# 2. Put both below, then run `npm run higgsfield:check` to check them (makes one small image).
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Spending guard: most minutes of new video per calendar month (each lesson is about 1 to 1.5 minutes).
# There is no free test mode on Higgsfield, so start low.
HIGGSFIELD_MONTHLY_MINUTES=20
# Optional: who presents the lessons, and a fixed seed so the presenter looks alike in every lesson
HIGGSFIELD_PRESENTER=a friendly, confident Indian woman in her thirties wearing smart-casual clothes
HIGGSFIELD_SEED=4242
# Optional: other Higgsfield models with the same inputs (see docs.higgsfield.ai/docs/models)
# HIGGSFIELD_IMAGE_MODEL=/higgsfield-ai/soul/v2/standard
# HIGGSFIELD_VIDEO_MODEL=/kling-video/v3.0/pro/image-to-video

# Brevo free plan allows 300 emails a day. Verify the sender in Brevo, then create an API key
# under SMTP & API > API keys. When set, BREVO_API_KEY takes precedence over SMTP.

# Optional: Google Places suggestions for the homepage Location box (Places API (New)). Without it, OpenStreetMap is used.
GOOGLE_MAPS_API_KEY=

# WhatsApp & Calls tab: the Govianu Hub running on this server (same HUB_API_KEY as in the Hub .env)
HUB_URL=http://127.0.0.1:4100
HUB_API_KEY=
# Secret code that opens the admin view of WhatsApp & Calls (all employees). Share it only with admins.
ADMIN_VIEW_CODE=
