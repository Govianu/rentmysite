# ── Govianu Hub ── (never commit this file)
PORT=4100
# APP_URL=https://hub.govianu.com
# BASE_PATH=/hub          # only if served at govianu.com/hub instead of a subdomain
JWT_SECRET=
STAFF_EMAIL_DOMAIN=govianu.com
# Comma-separated admin emails (they see everyone's numbers). If empty, the first person to sign in becomes admin.
ADMIN_EMAILS=

# MyOperator (panel → APIs & Webhooks → Developer API → WhatsApp APIs)
MYOP_BASE=https://publicapi.myoperator.co
MYOP_COMPANY_ID=
MYOP_API_KEY=
# Filled automatically from the first WhatsApp webhook; set it here if you know it
MYOP_WA_PHONE_NUMBER_ID=
WA_NUMBER_LABEL=8103990990
# Shared secret MyOperator sends in the "X-Webhook-Token" header (Webhooks v2 → Additional Headers)
MYOP_WEBHOOK_TOKEN=
# Calling API token (Developer API → Calling APIs → Authentication) – needed to play call recordings
MYOP_CALL_TOKEN=
# true = log instead of sending to MyOperator (testing)
MYOP_DRY_RUN=true

# Claude API key for AI replies (your rentmysite .env may already have one)
ANTHROPIC_API_KEY=

# Email (Zoho example). Without these, emails are written to data/outbox/
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Govianu <info@govianu.com>"

# Leads sheet + optional Google service account for live import
SHEET_ID=1fiWXA-gd2BDXjgjIYBiiHSJ2F8CQNIflMc6vWJuR7vo
GOOGLE_SERVICE_ACCOUNT_FILE=
# The two websites' data files on the VPS (read-only sync of their leads/emails)
RMS_DATA_FILE=../data/app-data.json
PMB_DATA_FILE=/path/to/partnermybusiness/data/app-data.json

# Shared secret the two websites use to call the Hub
HUB_API_KEY=
RMS_DASHBOARD_URL=https://rentmysite.ai/admin.html
PMB_DASHBOARD_URL=https://partnermybusiness.ai/admin.html

# PartnerMyBusiness leads are emailed from PMB's own mailbox (falls back to the SMTP_* mailbox above)
PMB_SMTP_HOST=
PMB_SMTP_PORT=465
PMB_SMTP_USER=
PMB_SMTP_PASS=
PMB_MAIL_FROM=
